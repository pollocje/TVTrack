@model TVTrack.Models.ViewModels.SearchViewModel
@{
    ViewData["Title"] = Model.Query != null ? $"Search: {Model.Query}" : "Search Shows";
    bool hasQuery = !string.IsNullOrWhiteSpace(Model.Query);
    bool hasResults = Model.Results.Any();
}

@if (!hasQuery)
{
    <!-- Hero: shown when there's no search query yet -->
    <div class="search-hero">
        <h1>Discover TV Shows</h1>
        <p>Search millions of shows, track what you watch, and share your reviews.</p>
        <form method="get" asp-action="Search">
            <div class="d-flex justify-content-center">
                <input type="text" name="query" class="search-input-lg" style="width:420px"
                       placeholder="Search for a TV show..." autofocus />
                <button type="submit" class="search-btn-lg">Search</button>
            </div>
        </form>
    </div>
}
else
{
    <!-- Inline search bar when results are showing -->
    <div class="mb-4">
        <form method="get" asp-action="Search">
            <div class="d-flex">
                <input type="text" name="query" value="@Model.Query" class="search-input-lg flex-grow-1"
                       placeholder="Search for a TV show..." />
                <button type="submit" class="search-btn-lg">Search</button>
            </div>
        </form>
    </div>

    @if (!hasResults)
    {
        <p class="text-center" style="color:var(--tv-muted); margin-top:3rem;">
            No results found for <strong style="color:var(--tv-text);">"@Model.Query"</strong>.
        </p>
    }
    else
    {
        <p style="color:var(--tv-muted); font-size:0.875rem; margin-bottom:1.25rem;">
            @Model.TotalResults results for <strong style="color:var(--tv-text);">"@Model.Query"</strong>
        </p>

        <div class="row row-cols-2 row-cols-sm-3 row-cols-md-4 row-cols-lg-5 g-3">
            @foreach (var show in Model.Results)
            {
                <div class="col">
                    <div class="show-card">
                        @if (show.PosterUrl != null)
                        {
                            <img src="@show.PosterUrl" class="show-card-poster" alt="@show.Title" />
                        }
                        else
                        {
                            <div class="show-card-poster-placeholder">No Image</div>
                        }
                        <div class="show-card-body">
                            <div class="show-card-title">@show.Title</div>
                            <a asp-action="Details" asp-route-id="@show.TmdbId" class="show-card-link">View Details</a>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Pagination -->
        <div class="d-flex gap-2 mt-4">
            @if (Model.Page > 1)
            {
                <a asp-action="Search" asp-route-query="@Model.Query" asp-route-page="@(Model.Page - 1)"
                   class="btn-page">&larr; Previous</a>
            }
            @if (Model.Results.Count == 20)
            {
                <a asp-action="Search" asp-route-query="@Model.Query" asp-route-page="@(Model.Page + 1)"
                   class="btn-page">Next &rarr;</a>
            }
        </div>
    }
}
