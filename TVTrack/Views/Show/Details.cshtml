@model TVTrack.Models.ViewModels.ShowViewModel
@{
    ViewData["Title"] = Model.Title;
    bool isAuth = User.Identity?.IsAuthenticated == true;

    string firstYear = Model.FirstAirDate?.Length >= 4 ? Model.FirstAirDate[..4] : Model.FirstAirDate ?? "";
}

<!-- ── Top section: poster + info ──────────────────── -->
<div class="row g-4 mb-4">

    <!-- Poster -->
    <div class="col-md-3 col-lg-2">
        @if (Model.PosterUrl != null)
        {
            <img src="@Model.PosterUrl" class="details-poster" alt="@Model.Title poster" />
        }
        else
        {
            <div class="details-poster-placeholder">No Image</div>
        }
    </div>

    <!-- Info -->
    <div class="col-md-9 col-lg-10">
        <h1 class="details-title">@Model.Title</h1>

        <!-- Meta pills -->
        <div class="mb-3">
            @if (!string.IsNullOrEmpty(firstYear))
            {
                <span class="meta-pill">@firstYear</span>
            }
            @if (Model.NumberOfSeasons != null)
            {
                <span class="meta-pill">@Model.NumberOfSeasons season@(Model.NumberOfSeasons != 1 ? "s" : "")</span>
            }
        </div>

        <!-- Avg rating -->
        @if (Model.AvgRating != null)
        {
            <div class="mb-3">
                <span class="avg-rating">
                    &#9733; @Model.AvgRating.Value.ToString("F1")
                    <span>/ 5</span>
                </span>
            </div>
        }

        <!-- Overview -->
        @if (!string.IsNullOrEmpty(Model.Overview))
        {
            <p class="overview-text">@Model.Overview</p>
        }

        <!-- Watchlist + Log + List actions -->
        @if (isAuth)
        {
            <div class="mt-3 d-flex flex-wrap gap-2 align-items-center">
                @if (Model.IsInWatchlist)
                {
                    <form asp-action="RemoveFromWatchlist" method="post" style="display:inline">
                        <input type="hidden" name="tmdbId" value="@Model.TmdbId" />
                        <button type="submit" class="btn-watchlist-remove">&#10003; In Watchlist &mdash; Remove</button>
                    </form>
                }
                else
                {
                    <form asp-action="AddToWatchlist" method="post" style="display:inline">
                        <input type="hidden" name="tmdbId" value="@Model.TmdbId" />
                        <button type="submit" class="btn-watchlist-add">+ Add to Watchlist</button>
                    </form>
                }

                <button type="button" class="btn-log-add" data-bs-toggle="modal" data-bs-target="#logModal">
                    &#9998; Log
                </button>

                <button type="button" class="btn-list-add" data-bs-toggle="modal" data-bs-target="#addToListModal">
                    &#9776; Add to List
                </button>
            </div>
        }

        <!-- Log Modal -->
        @if (isAuth)
        {
            <div class="modal fade" id="logModal" tabindex="-1" aria-labelledby="logModalLabel" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content modal-dark">
                        <div class="modal-header">
                            <h5 class="modal-title" id="logModalLabel">Log @Model.Title</h5>
                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <form asp-action="Log" method="post">
                                <input type="hidden" name="TmdbId" value="@Model.TmdbId" />

                                <!-- Log type -->
                                <div class="mb-3">
                                    <label class="form-label text-light">What did you watch?</label>
                                    <div class="d-flex gap-3">
                                        <div class="form-check">
                                            <input class="form-check-input" type="radio" name="LogType" value="0" id="logTypeSeries" checked />
                                            <label class="form-check-label text-light" for="logTypeSeries">Series</label>
                                        </div>
                                        <div class="form-check">
                                            <input class="form-check-input" type="radio" name="LogType" value="1" id="logTypeSeason" />
                                            <label class="form-check-label text-light" for="logTypeSeason">Season</label>
                                        </div>
                                        <div class="form-check">
                                            <input class="form-check-input" type="radio" name="LogType" value="2" id="logTypeEpisode" />
                                            <label class="form-check-label text-light" for="logTypeEpisode">Episode</label>
                                        </div>
                                    </div>
                                </div>

                                <!-- Season number (Season + Episode) -->
                                <div class="mb-3 d-none" id="seasonField">
                                    <label class="form-label text-light">Season Number</label>
                                    <input type="number" name="SeasonNumber" class="form-control form-control-dark" min="1" />
                                </div>

                                <!-- Episode fields -->
                                <div class="mb-3 d-none" id="episodeFields">
                                    <label class="form-label text-light">Episode Number</label>
                                    <input type="number" name="EpisodeNumber" class="form-control form-control-dark mb-2" min="1" />
                                    <label class="form-label text-light">Episode Title <span class="text-muted">(optional)</span></label>
                                    <input type="text" name="EpisodeTitle" class="form-control form-control-dark" maxlength="200" />
                                </div>

                                <!-- Rating -->
                                <div class="mb-3">
                                    <label class="form-label text-light">Rating <span class="text-muted">(optional)</span></label>
                                    <div class="log-star-rating" id="logStarRating">
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            <button type="button" class="log-star-btn" data-value="@i">&#9733;</button>
                                        }
                                    </div>
                                    <input type="hidden" name="Rating" id="logRatingInput" value="" />
                                </div>

                                <!-- Review -->
                                <div class="mb-3">
                                    <label class="form-label text-light">Review <span class="text-muted">(optional)</span></label>
                                    <textarea name="Review" class="review-textarea" rows="3" placeholder="What did you think?"></textarea>
                                </div>

                                <!-- Date -->
                                <div class="mb-4">
                                    <label class="form-label text-light">Watch Date</label>
                                    <input type="date" name="WatchedOn" class="form-control form-control-dark"
                                           value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                                </div>

                                <button type="submit" class="btn-submit-review w-100">Save Log</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- Add to List Modal -->
        @if (isAuth)
        {
            <div class="modal fade" id="addToListModal" tabindex="-1" aria-labelledby="addToListModalLabel" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content modal-dark">
                        <div class="modal-header">
                            <h5 class="modal-title" id="addToListModalLabel">Add to List</h5>
                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">

                            @if (Model.UserLists.Any())
                            {
                                <form asp-action="AddToList" method="post">
                                    <input type="hidden" name="tmdbId" value="@Model.TmdbId" />
                                    <label class="form-label text-light">Choose an existing list</label>
                                    <select name="listId" class="form-select form-select-dark mb-3">
                                        @foreach (var list in Model.UserLists)
                                        {
                                            <option value="@list.Id">@list.Name</option>
                                        }
                                    </select>
                                    <button type="submit" class="btn-submit-review w-100">Add to Selected List</button>
                                </form>
                                <hr class="divider-dark" />
                            }

                            <form asp-action="CreateList" method="post">
                                <input type="hidden" name="tmdbId" value="@Model.TmdbId" />
                                <label class="form-label text-light">Create a new list</label>
                                <input type="text" name="listName" class="form-control form-control-dark mb-3"
                                       placeholder="List name..." maxlength="100" required />
                                <button type="submit" class="btn-watchlist-add w-100">Create &amp; Add Show</button>
                            </form>

                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<!-- ── Season / Episode Browser ────────────────────── -->
@if (Model.NumberOfSeasons != null && Model.NumberOfSeasons > 0)
{
    <div class="section-card mb-4" id="seasonBrowser">
        <div class="d-flex align-items-center gap-3 mb-3">
            <label for="seasonSelect" class="fw-semibold mb-0" style="white-space:nowrap">Season</label>
            <select id="seasonSelect" class="season-select">
                @for (int s = 1; s <= Model.NumberOfSeasons; s++)
                {
                    <option value="@s">Season @s</option>
                }
            </select>
        </div>

        <!-- Episode count + nav -->
        <div id="episodeNav" style="display:none">
            <p id="episodeCount" class="episode-count-label"></p>
            <div class="episode-nav-row">
                <button id="prevEp" class="ep-nav-btn" disabled>&lsaquo;</button>
                <span id="epIndicator" class="ep-indicator"></span>
                <button id="nextEp" class="ep-nav-btn">&rsaquo;</button>
            </div>
        </div>

        <!-- Episode card -->
        <div id="episodeCard" style="display:none" class="episode-card mt-3">
            <img id="epStill" src="" alt="" class="episode-still" />
            <div class="episode-info">
                <h5 id="epTitle" class="episode-title"></h5>
                <p id="epDesc" class="episode-desc"></p>
            </div>
        </div>

        <div id="episodeLoading" style="display:none" class="episode-loading">Loading...</div>
    </div>
}

@if (!isAuth)
{
    <div class="section-card mb-4">
        <p class="auth-prompt mb-0">
            <a asp-controller="Account" asp-action="Login">Log in</a> to add this show to your watchlist or log it.
        </p>
    </div>
}

<!-- ── Recent Logs ───────────────────────────────────── -->
@if (Model.RecentLogs.Any())
{
    <div class="section-card">
        <h5>Recent Logs (@Model.RecentLogs.Count)</h5>
        <div class="log-list mt-2">
            @foreach (var log in Model.RecentLogs)
            {
                <div class="log-entry d-flex gap-3 align-items-start">
                    <div class="log-body flex-grow-1">
                        <div class="d-flex align-items-center gap-2 flex-wrap">
                            <span class="log-title">@log.Username</span>
                            <span class="meta-pill">@log.LogLabel</span>
                            @if (log.Rating.HasValue)
                            {
                                <span class="log-stars">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        <span class="@(i <= log.Rating ? "star-filled" : "star-empty")">&#9733;</span>
                                    }
                                </span>
                            }
                            <span class="log-date text-muted small">@log.WatchedOn.ToString("MMM d, yyyy")</span>
                        </div>
                        @if (!string.IsNullOrEmpty(log.Review))
                        {
                            <p class="log-review mt-1 mb-0">@log.Review</p>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
}

@section Scripts {
    <script>
        // Log modal: show/hide season/episode fields based on log type
        document.querySelectorAll('input[name="LogType"]').forEach(radio => {
            radio.addEventListener('change', () => {
                const val = parseInt(radio.value);
                document.getElementById('seasonField').classList.toggle('d-none', val === 0);
                document.getElementById('episodeFields').classList.toggle('d-none', val !== 2);
            });
        });

        // Log modal: star rating
        const logStars = document.querySelectorAll('.log-star-btn');
        const logRatingInput = document.getElementById('logRatingInput');
        let selectedRating = 0;

        logStars.forEach(star => {
            star.addEventListener('mouseenter', () => {
                const val = parseInt(star.dataset.value);
                logStars.forEach(s => s.classList.toggle('active', parseInt(s.dataset.value) <= val));
            });
            star.addEventListener('click', () => {
                selectedRating = parseInt(star.dataset.value);
                logRatingInput.value = selectedRating;
                logStars.forEach(s => s.classList.toggle('active', parseInt(s.dataset.value) <= selectedRating));
            });
        });

        document.getElementById('logStarRating')?.addEventListener('mouseleave', () => {
            logStars.forEach(s => s.classList.toggle('active', parseInt(s.dataset.value) <= selectedRating));
        });

        // Season / episode browser
        (function () {
            const showId = @Model.TmdbId;
            const seasonSelect = document.getElementById('seasonSelect');
            if (!seasonSelect) return;

            let episodes = [];
            let currentIndex = 0;

            const episodeNav    = document.getElementById('episodeNav');
            const episodeCard   = document.getElementById('episodeCard');
            const episodeLoading = document.getElementById('episodeLoading');
            const episodeCount  = document.getElementById('episodeCount');
            const epIndicator   = document.getElementById('epIndicator');
            const epStill       = document.getElementById('epStill');
            const epTitle       = document.getElementById('epTitle');
            const epDesc        = document.getElementById('epDesc');
            const prevBtn       = document.getElementById('prevEp');
            const nextBtn       = document.getElementById('nextEp');

            function showEpisode(index) {
                currentIndex = index;
                const ep = episodes[index];

                epTitle.textContent = `Ep ${ep.episodeNumber}: ${ep.name}`;
                epDesc.textContent  = ep.overview || 'No description available.';
                epIndicator.textContent = `${index + 1} / ${episodes.length}`;

                if (ep.stillUrl) {
                    epStill.src = ep.stillUrl;
                    epStill.style.display = '';
                } else {
                    epStill.style.display = 'none';
                }

                prevBtn.disabled = index === 0;
                nextBtn.disabled = index === episodes.length - 1;
            }

            async function loadSeason(seasonNumber) {
                episodeNav.style.display  = 'none';
                episodeCard.style.display = 'none';
                episodeLoading.style.display = '';

                try {
                    const res = await fetch(`/Show/Season/${showId}/${seasonNumber}`);
                    if (!res.ok) throw new Error('Failed');
                    const data = await res.json();
                    episodes = data.episodes || [];

                    episodeLoading.style.display = 'none';

                    if (episodes.length === 0) return;

                    episodeCount.textContent = `${episodes.length} episode${episodes.length !== 1 ? 's' : ''} in this season`;
                    episodeNav.style.display  = '';
                    episodeCard.style.display = '';
                    showEpisode(0);
                } catch {
                    episodeLoading.textContent = 'Could not load episodes.';
                }
            }

            seasonSelect.addEventListener('change', () => loadSeason(seasonSelect.value));
            prevBtn.addEventListener('click', () => showEpisode(currentIndex - 1));
            nextBtn.addEventListener('click', () => showEpisode(currentIndex + 1));

            // Auto-load season 1
            loadSeason(1);
        })();
    </script>
}
