@model TVTrack.Models.ViewModels.ListDetailViewModel
@{
    ViewData["Title"] = Model.Name;
}

<div class="section-card mb-4">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
        <div>
            <h2 class="details-title mb-1">@Model.Name</h2>
            <p class="text-muted small mb-0">
                by <a asp-controller="Account" asp-action="ViewProfile"
                      asp-route-username="@Model.OwnerUsername" class="log-title">@Model.OwnerUsername</a>
                &mdash; @Model.Shows.Count show@(Model.Shows.Count != 1 ? "s" : "")
            </p>
            @if (!string.IsNullOrEmpty(Model.Description))
            {
                <p class="overview-text mt-2 mb-0">@Model.Description</p>
            }
        </div>

        @if (Model.IsOwner)
        {
            <div class="d-flex gap-2 flex-wrap align-items-center">
                @if (!string.IsNullOrEmpty(Model.ShareToken))
                {
                    var shareUrl = $"{Context.Request.Scheme}://{Context.Request.Host}/List/Share/{Model.ShareToken}";
                    <button type="button" class="btn-list-add"
                            onclick="navigator.clipboard.writeText('@shareUrl').then(() => this.textContent = 'Copied!').catch(() => this.textContent = 'Copy failed')">
                        &#128279; Copy Share Link
                    </button>
                }

                <form asp-controller="List" asp-action="Delete" method="post"
                      onsubmit="return confirm('Delete this list? This cannot be undone.')">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="listId" value="@Model.ListId" />
                    <button type="submit" class="btn-watchlist-remove">&#128465; Delete List</button>
                </form>
            </div>
        }
    </div>
</div>

@if (Model.Shows.Any())
{
    <div class="section-card">
        <div class="row row-cols-2 row-cols-sm-3 row-cols-md-4 row-cols-lg-6 g-3">
            @foreach (var show in Model.Shows)
            {
                <div class="col">
                    <div class="show-card h-100">
                        @if (show.PosterUrl != null)
                        {
                            <img src="@show.PosterUrl" class="show-card-poster" alt="@show.Title" />
                        }
                        else
                        {
                            <div class="show-card-poster-placeholder">No Image</div>
                        }
                        <div class="show-card-body">
                            <div class="show-card-title">@show.Title</div>
                            <a asp-controller="Show" asp-action="Details" asp-route-id="@show.TmdbId"
                               class="show-card-link mt-2">View</a>
                            @if (Model.IsOwner)
                            {
                                <form asp-controller="List" asp-action="RemoveShow" method="post" class="mt-1">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="listId" value="@Model.ListId" />
                                    <input type="hidden" name="tmdbId" value="@show.TmdbId" />
                                    <button type="submit" class="btn-watchlist-remove w-100">Remove</button>
                                </form>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
}
else
{
    <div class="section-card">
        <p class="text-muted mb-0">No shows in this list yet.</p>
    </div>
}
